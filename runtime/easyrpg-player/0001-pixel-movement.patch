+#define EP_PIXEL_MOVEMENT_H
+
+#include "game_dynrpg.h"
+#include <vector>
+
+class Game_Character;
+class Game_Event;
+class Game_Player;
+
+/**
+ * Pixel movement (prototype): the hero walks in pixel steps instead of whole tiles,
+ * with a hitbox that collides with the map's passability and with events.
+ *
+ * Opt-in per game: lcf-plugins/pixel_movement.json in the game folder (written by
+ * the pixel movement plugin of godot-lcf-editor):
+ *
+ *     { "enabled": true, "hero": { "x": 2, "y": 4, "width": 12, "height": 12 } }
+ *
+ * The hitbox is in pixels, relative to the top-left corner of the character's
+ * tile. Events have the whole tile as hitbox unless the first commands of their
+ * active page include the comment "@pixel_hitbox x, y, width, height".
+ *
+ * Game logic stays tile based: the hero's tile is the tile under the centre of its
+ * hitbox, so triggers, terrain, encounters and teleports work as before. Comment
+ * commands (with EasyRPG extensions or in DynRPG mode):
+ *   @pixel_movement 1|0         turn pixel movement on or off
+ *   @pixel_move target, dx, dy  move the hero (10001) with collision, or shift an
+ *                               event's sprite, by dx, dy pixels
+ */
+namespace PixelMovement {
+	/** A rectangle in sub-pixel units (16 per pixel) or pixels, as noted. */
+	struct Box {
+		int x = 0;
+		int y = 0;
+		int w = 0;
+		int h = 0;
+	};
+
+	/** Forgets settings and caches (new game, loaded game, title). */
+	void Reset();
+
+	/** True if the game uses pixel movement right now. */
+	bool IsEnabled();
+
+	/** Turns pixel movement on or off for this session (@pixel_movement). */
+	void SetEnabled(bool enabled);
+
+	/** The hero's hitbox in pixels, relative to its tile's top-left corner. */
+	Box HeroHitbox();
+
+	/** An event's hitbox in pixels, relative to its tile (whole tile by default). */
+	Box EventHitbox(const Game_Event& ev);
+
+	/**
+	 * Moves the hero along one axis by `amount` sub-pixel units (only one of dx, dy
+	 * is non-zero), stopping at impassable tiles and blocking events. Events the
+	 * hero bumps into are added to `bumped`.
+	 * @return the distance actually moved.
+	 */
+	int Step(Game_Player& hero, int dx, int dy, bool through, std::vector<Game_Event*>& bumped);
+
+	/** Pixel movement's comment commands. */
+	class Plugin : public DynRpgPlugin {
+	public:
+		explicit Plugin(Game_DynRpg& instance) : DynRpgPlugin("PixelMovement", instance) {}
+		bool Invoke(std::string_view func, dyn_arg_list args, bool& do_yield, Game_Interpreter* interpreter) override;
+	};
+}
+
+#endif
