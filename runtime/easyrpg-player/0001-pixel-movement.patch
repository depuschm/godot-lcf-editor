+#include "pixel_movement.h"
+#include "filefinder.h"
+#include "game_event.h"
+#include "game_map.h"
+#include "game_player.h"
+#include "main_data.h"
+#include "output.h"
+
+#ifdef HAVE_NLOHMANN_JSON
+#include "json_helper.h"
+#endif
+
+#include <iterator>
+#include <optional>
+#include <unordered_map>
+
+namespace {
+	constexpr int S = SCREEN_TILE_SIZE;             // sub-pixel units per tile
+	constexpr int P = SCREEN_TILE_SIZE / TILE_SIZE; // sub-pixel units per pixel
+
+	struct PixelState {
+		bool loaded = false;
+		bool enabled = false;
+		std::optional<bool> session; // set by @pixel_movement
+		PixelMovement::Box hero = { 2, 4, 12, 12 };
+		std::unordered_map<const lcf::rpg::EventPage*, PixelMovement::Box> event_boxes;
+	} state;
+
+	int FloorDiv(int a, int b) {
+		return a >= 0 ? a / b : -((-a + b - 1) / b);
+	}
+
+	PixelMovement::Box Sanitized(PixelMovement::Box b) {
+		b.w = std::max(1, b.w);
+		b.h = std::max(1, b.h);
+		return b;
+	}
+
+	void Load() {
+		if (state.loaded) {
+			return;
+		}
+		state.loaded = true;
+		auto is = FileFinder::Game().OpenFile("lcf-plugins", "pixel_movement.json");
+		if (!is) {
+			return;
+		}
+#ifdef HAVE_NLOHMANN_JSON
+		std::string text((std::istreambuf_iterator<char>(is)), std::istreambuf_iterator<char>());
+		json j = json::parse(text, nullptr, false);
+		if (j.is_discarded() || !j.is_object()) {
+			Output::Warning("PixelMovement: lcf-plugins/pixel_movement.json is not valid JSON");
+			return;
+		}
+		state.enabled = j.value("enabled", false);
+		if (j.contains("hero") && j["hero"].is_object()) {
+			const auto& h = j["hero"];
+			state.hero = Sanitized({ h.value("x", 2), h.value("y", 4), h.value("width", 12), h.value("height", 12) });
+		}
+		Output::Debug("PixelMovement: {}, hero hitbox {} {} {}x{}", state.enabled ? "on" : "off",
+			state.hero.x, state.hero.y, state.hero.w, state.hero.h);
+#else
+		Output::Warning("PixelMovement: this Player was built without JSON support; pixel_movement.json is ignored");
+#endif
+	}
+
+	// The hitbox of a character in sub-pixel map coordinates.
+	PixelMovement::Box Absolute(const Game_Character& ch, PixelMovement::Box rel) {
+		return {
+			ch.GetX() * S + ch.GetPixelOffsetX() + rel.x * P,
+			ch.GetY() * S + ch.GetPixelOffsetY() + rel.y * P,
+			rel.w * P,
+			rel.h * P
+		};
+	}
+
+	bool Overlap1D(int a, int a_len, int b, int b_len) {
+		return a < b + b_len && b < a + a_len;
+	}
+
+	// RPG Maker's tile rules for a step between two neighbouring tiles (map only).
+	bool TilePassage(const Game_Character& ch, int from_x, int from_y, int to_x, int to_y) {
+		return Game_Map::CheckWay(ch, from_x, from_y, to_x, to_y, false, Span<int>());
+	}
+
+	// Shortens a move so the hitbox stops at the border of the first tile it may not enter.
+	int LimitByTiles(const Game_Character& ch, const PixelMovement::Box& b, bool horizontal, int amount) {
+		const int pos = horizontal ? b.x : b.y;
+		const int len = horizontal ? b.w : b.h;
+		const int across_first = FloorDiv(horizontal ? b.y : b.x, S);
+		const int across_last = FloorDiv((horizontal ? b.y + b.h : b.x + b.w) - 1, S);
+		auto passable = [&](int from, int to, int across) {
+			return horizontal ? TilePassage(ch, from, across, to, across) : TilePassage(ch, across, from, across, to);
+		};
+		if (amount > 0) {
+			const int edge = pos + len; // exclusive
+			for (int t = FloorDiv(edge - 1, S) + 1; t <= FloorDiv(edge - 1 + amount, S); ++t) {
+				for (int a = across_first; a <= across_last; ++a) {
+					if (!passable(t - 1, t, a)) {
+						return t * S - edge;
+					}
+				}
+			}
+		} else {
+			const int edge = pos;
+			for (int t = FloorDiv(edge, S) - 1; t >= FloorDiv(edge + amount, S); --t) {
+				for (int a = across_first; a <= across_last; ++a) {
+					if (!passable(t + 1, t, a)) {
+						return (t + 1) * S - edge;
+					}
+				}
+			}
+		}
+		return amount;
+	}
+
+	// Shortens a move so the hitbox stops at blocking events (same layer as the hero).
+	int LimitByEvents(const PixelMovement::Box& b, bool horizontal, int amount, std::vector<Game_Event*>& bumped) {
+		std::vector<std::pair<Game_Event*, int>> hits;
+		for (auto& ev: Game_Map::GetEvents()) {
+			if (!ev.IsActive() || ev.GetActivePage() == nullptr || ev.GetThrough()
+					|| ev.GetLayer() != lcf::rpg::EventPage::Layers_same) {
+				continue;
+			}
+			const auto e = Absolute(ev, PixelMovement::EventHitbox(ev));
+			const bool across = horizontal ? Overlap1D(b.y, b.h, e.y, e.h) : Overlap1D(b.x, b.w, e.x, e.w);
+			const bool along = horizontal ? Overlap1D(b.x, b.w, e.x, e.w) : Overlap1D(b.y, b.h, e.y, e.h);
+			if (!across || along) {
+				continue; // not in the way, or already overlapping (never get stuck)
+			}
+			int gap;
+			if (amount > 0) {
+				gap = horizontal ? e.x - (b.x + b.w) : e.y - (b.y + b.h);
+				if (gap < 0 || gap >= amount) continue; // behind the hero, or not reached
+			} else {
+				gap = horizontal ? (e.x + e.w) - b.x : (e.y + e.h) - b.y;
+				if (gap > 0 || gap <= amount) continue;
+			}
+			amount = gap;
+			hits.emplace_back(&ev, gap);
+		}
+		for (auto& hit: hits) {
+			if (hit.second == amount) {
+				bumped.push_back(hit.first);
+			}
+		}
+		return amount;
+	}
+}
+
+void PixelMovement::Reset() {
+	state = PixelState();
+}
+
+bool PixelMovement::IsEnabled() {
+	Load();
+	if (Game_Map::LoopHorizontal() || Game_Map::LoopVertical()) {
+		return false; // not supported by the prototype
+	}
+	return state.session.value_or(state.enabled);
+}
+
+void PixelMovement::SetEnabled(bool enabled) {
+	Load();
+	state.session = enabled;
+}
+
+PixelMovement::Box PixelMovement::HeroHitbox() {
+	Load();
+	return state.hero;
+}
+
+PixelMovement::Box PixelMovement::EventHitbox(const Game_Event& ev) {
+	const auto* page = ev.GetActivePage();
+	if (page == nullptr) {
+		return { 0, 0, TILE_SIZE, TILE_SIZE };
+	}
+	auto it = state.event_boxes.find(page);
+	if (it != state.event_boxes.end()) {
+		return it->second;
+	}
+	Box box = { 0, 0, TILE_SIZE, TILE_SIZE };
+	// "@pixel_hitbox x, y, w, h" among the comments at the top of the page.
+	for (const auto& cmd: page->event_commands) {
+		if (cmd.code != static_cast<int>(lcf::rpg::EventCommand::Code::Comment)
+				&& cmd.code != static_cast<int>(lcf::rpg::EventCommand::Code::Comment_2)) {
+			break;
+		}
+		std::vector<std::string> args;
+		if (DynRpg::ParseCommand(ToString(cmd.string), args) == "pixel_hitbox" && args.size() >= 4) {
+			bool okay = true;
+			int x, y, w, h;
+			std::tie(x, y, w, h) = DynRpg::ParseArgs<int, int, int, int>("pixel_hitbox", args, &okay);
+			if (okay) {
+				box = Sanitized({ x, y, w, h });
+			}
+			break;
+		}
+	}
+	state.event_boxes[page] = box;
+	return box;
+}
+
+int PixelMovement::Step(Game_Player& hero, int dx, int dy, bool through, std::vector<Game_Event*>& bumped) {
+	const bool horizontal = dx != 0;
+	int amount = horizontal ? dx : dy;
+	if (amount == 0) {
+		return 0;
+	}
+	const Box rel = HeroHitbox();
+	if (!through) {
+		const Box b = Absolute(hero, rel);
+		amount = LimitByTiles(hero, b, horizontal, amount);
+		amount = LimitByEvents(b, horizontal, amount, bumped);
+	}
+	if (amount == 0) {
+		return 0;
+	}
+	// The hero's tile is the tile under the centre of its hitbox.
+	const int ox = hero.GetX() * S + hero.GetPixelOffsetX() + (horizontal ? amount : 0);
+	const int oy = hero.GetY() * S + hero.GetPixelOffsetY() + (horizontal ? 0 : amount);
+	const int tx = FloorDiv(ox + rel.x * P + rel.w * P / 2, S);
+	const int ty = FloorDiv(oy + rel.y * P + rel.h * P / 2, S);
+	hero.SetX(tx);
+	hero.SetY(ty);
+	hero.SetPixelOffset(ox - tx * S, oy - ty * S);
+	return amount;
+}
+
+bool PixelMovement::Plugin::Invoke(std::string_view func, dyn_arg_list args, bool&, Game_Interpreter*) {
+	if (func == "pixel_movement") {
+		bool okay = false;
+		int on;
+		std::tie(on) = DynRpg::ParseArgs<int>(func, args, &okay);
+		if (okay) {
+			SetEnabled(on != 0);
+		}
+		return true;
+	}
+	if (func == "pixel_move") {
+		bool okay = false;
+		int target, dx, dy;
+		std::tie(target, dx, dy) = DynRpg::ParseArgs<int, int, int>(func, args, &okay);
+		if (!okay) {
+			return true;
+		}
+		if (target == Game_Character::CharPlayer) {
+			auto& hero = *Main_Data::game_player;
+			std::vector<Game_Event*> bumped;
+			Step(hero, dx * P, 0, hero.GetThrough(), bumped);
+			Step(hero, 0, dy * P, hero.GetThrough(), bumped);
+		} else if (auto* ev = Game_Map::GetEvent(target)) {
+			ev->SetPixelOffset(ev->GetPixelOffsetX() + dx * P, ev->GetPixelOffsetY() + dy * P);
+		}
+		return true;
+	}
+	if (func == "pixel_hitbox") {
+		return true; // a declaration, read by EventHitbox()
+	}
+	return false;
+}
