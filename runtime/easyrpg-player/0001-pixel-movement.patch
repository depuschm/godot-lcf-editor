+bool Game_Player::UpdatePixelMovement() {
+	pixel_moved = false;
+	if (!PixelMovement::IsEnabled() || InVehicle() || IsBoardingOrUnboarding()) {
+		if (GetPixelOffsetX() != 0 || GetPixelOffsetY() != 0) {
+			SetPixelOffset(0, 0);
+		}
+		return false;
+	}
+
+	int dx = 0;
+	int dy = 0;
+	switch (Input::dir8) {
+		case 1: dx = -1; dy = 1; break;
+		case 2: dy = 1; break;
+		case 3: dx = 1; dy = 1; break;
+		case 4: dx = -1; break;
+		case 6: dx = 1; break;
+		case 7: dx = -1; dy = -1; break;
+		case 8: dy = -1; break;
+		case 9: dx = 1; dy = -1; break;
+	}
+	if (dx == 0 && dy == 0) {
+		return true;
+	}
+
+	// Face the way of the input. On a diagonal, keep the current facing if it is one
+	// of the two directions, otherwise face sideways.
+	const int horizontal = dx < 0 ? Left : Right;
+	const int vertical = dy < 0 ? Up : Down;
+	int dir;
+	if (dx != 0 && dy != 0) {
+		dir = (GetDirection() == horizontal || GetDirection() == vertical) ? GetDirection() : horizontal;
+	} else {
+		dir = dx != 0 ? horizontal : vertical;
+	}
+	SetDirection(dir);
+	if (!IsFacingLocked()) {
+		SetFacing(dir);
+	}
+
+	// Same speed as tile movement (sub-pixel units per frame); diagonals by 1/sqrt(2).
+	int amount = 1 << (1 + GetMoveSpeed());
+	if (dx != 0 && dy != 0) {
+		amount = amount * 181 / 256;
+	}
+	const bool through = (Player::debug_flag && Input::IsPressed(Input::DEBUG_THROUGH)) || data()->move_route_through;
+	const int old_x = GetX();
+	const int old_y = GetY();
+	std::vector<Game_Event*> bumped;
+	int moved = PixelMovement::Step(*this, dx * amount, 0, through, bumped);
+	moved |= PixelMovement::Step(*this, 0, dy * amount, through, bumped);
+	pixel_moved = moved != 0;
+	UpdatePixelScroll();
+
+	// Bumping into an event with a touch trigger starts it, as in tile movement.
+	for (auto* ev: bumped) {
+		const auto trigger = ev->GetTrigger();
+		if (trigger.has_value() && (*trigger == lcf::rpg::EventPage::Trigger_touched || *trigger == lcf::rpg::EventPage::Trigger_collision)) {
+			ev->ScheduleForegroundExecution(false, true);
+		}
+	}
+
+	// Entering a new tile counts as a step.
+	if (GetX() != old_x || GetY() != old_y) {
+		Main_Data::game_party->IncSteps();
+		if (Main_Data::game_party->ApplyStateDamage()) {
+			Main_Data::game_screen->FlashMapStepDamage();
+		}
+		UpdateEncounterSteps();
+		CheckEventTriggerHere({ lcf::rpg::EventPage::Trigger_touched, lcf::rpg::EventPage::Trigger_collision }, false);
+	}
+	return true;
+}
+
+void Game_Player::UpdatePixelScroll() {
+	if (IsPanLocked()) {
+		return;
+	}
+	const auto dx = GetSpriteX() - Game_Map::GetPositionX() - GetPanX();
+	const auto dy = GetSpriteY() - Game_Map::GetPositionY() - GetPanY();
+	Game_Map::Scroll(dx, dy);
+}
+
+void Game_Player::UpdateAnimation() {
+	if (pixel_moved) {
+		SetStopCount(0); // walking: animate like a moving character
+	}
+	Game_Character::UpdateAnimation();
+}
+
 void Game_Player::Update() {
 	Game_Character::Update();
 
