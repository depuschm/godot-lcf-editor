+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with EasyRPG Player. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "sdl2_shader.h"
+#include "output.h"
+#include "player.h"
+#include "screen_shader.h"
+
+// Only for the declarations: every function is loaded with SDL_GL_GetProcAddress,
+// so the Player does not link against OpenGL.
+#define GL_GLEXT_PROTOTYPES 1
+#include <SDL_opengl.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace {
+#define LCF_GL_FUNCTIONS(X) \
+	X(GetIntegerv) X(PushAttrib) X(PopAttrib) X(PushClientAttrib) X(PopClientAttrib) \
+	X(Viewport) X(Disable) X(Begin) X(End) X(TexCoord2f) X(Vertex2f) X(ReadPixels) \
+	X(PixelStorei) X(ActiveTexture) X(CreateShader) X(ShaderSource) X(CompileShader) \
+	X(GetShaderiv) X(GetShaderInfoLog) X(CreateProgram) X(AttachShader) X(LinkProgram) \
+	X(GetProgramiv) X(GetProgramInfoLog) X(DeleteShader) X(DeleteProgram) X(UseProgram) \
+	X(GetUniformLocation) X(Uniform1i) X(Uniform1f) X(Uniform2f) X(Uniform3f) X(Uniform4f)
+
+	struct Gl {
+#define LCF_GL_MEMBER(name) decltype(&::gl##name) name = nullptr;
+		LCF_GL_FUNCTIONS(LCF_GL_MEMBER)
+#undef LCF_GL_MEMBER
+
+		bool Load() {
+			bool ok = true;
+#define LCF_GL_LOAD(name) \
+			name = reinterpret_cast<decltype(name)>(SDL_GL_GetProcAddress("gl" #name)); \
+			if (!name) { Output::Warning("ScreenShader: OpenGL function gl" #name " not found"); ok = false; }
+			LCF_GL_FUNCTIONS(LCF_GL_LOAD)
+#undef LCF_GL_LOAD
+			return ok;
+		}
+	};
+
+	constexpr const char* vertex_source =
+		"#version 120\n"
+		"void main() {\n"
+		"	gl_TexCoord[0] = gl_MultiTexCoord0;\n"
+		"	gl_Position = gl_Vertex;\n"
+		"}\n";
+
+	// What a shader file can use: pixel(uv), resolution and time.
+	constexpr const char* fragment_prefix =
+		"#version 120\n"
+		"uniform sampler2D lcf_screen;\n"
+		"uniform vec2 lcf_tex_scale;\n"
+		"uniform vec2 resolution;\n"
+		"uniform float time;\n"
+		"vec4 pixel(vec2 uv) { return texture2D(lcf_screen, clamp(uv, 0.0, 1.0) * lcf_tex_scale); }\n"
+		"#line 1\n";
+
+	constexpr const char* fragment_suffix =
+		"\nvoid main() { gl_FragColor = vec4(effect(gl_TexCoord[0].xy).rgb, 1.0); }\n";
+
+	void WriteBmp(const char* path, int w, int h, const std::vector<unsigned char>& bgr, int stride) {
+		std::FILE* f = std::fopen(path, "wb");
+		if (!f) {
+			return;
+		}
+		auto u32 = [&](uint32_t v) { unsigned char b[4] = { (unsigned char)v, (unsigned char)(v >> 8), (unsigned char)(v >> 16), (unsigned char)(v >> 24) }; std::fwrite(b, 1, 4, f); };
+		auto u16 = [&](uint16_t v) { unsigned char b[2] = { (unsigned char)v, (unsigned char)(v >> 8) }; std::fwrite(b, 1, 2, f); };
+		std::fwrite("BM", 1, 2, f);
+		u32(54 + stride * h); u32(0); u32(54);
+		u32(40); u32(w); u32(h); u16(1); u16(24); u32(0); u32(stride * h); u32(2835); u32(2835); u32(0); u32(0);
+		std::fwrite(bgr.data(), 1, bgr.size(), f); // OpenGL rows are bottom-up, like BMP
+		std::fclose(f);
+	}
+}
+
+struct Sdl2ShaderPass::Impl {
+	Gl gl;
+	bool checked = false;
+	bool usable = false;
+	const ScreenShader::Shader* shader = nullptr;
+	GLuint program = 0;
+	std::string failed; // the shader that did not compile
+	const char* capture = nullptr;
+	int capture_frame = -1; // -1: every 10 frames
+	bool captured = false;
+
+	GLuint Compile(GLenum type, const std::string& source, const std::string& name) {
+		GLuint s = gl.CreateShader(type);
+		const char* text = source.c_str();
+		gl.ShaderSource(s, 1, &text, nullptr);
+		gl.CompileShader(s);
+		GLint ok = 0;
+		gl.GetShaderiv(s, GL_COMPILE_STATUS, &ok);
+		if (!ok) {
+			char log[2048] = {};
+			gl.GetShaderInfoLog(s, sizeof(log), nullptr, log);
+			Output::Warning("ScreenShader: Shader/{}.glsl does not compile:\n{}", name, log);
+			gl.DeleteShader(s);
+			return 0;
+		}
+		return s;
+	}
+
+	bool Use(const ScreenShader::Shader& next) {
+		if (shader == &next && program) {
+			return true;
+		}
+		if (failed == next.name) {
+			return false;
+		}
+		if (program) {
+			gl.DeleteProgram(program);
+			program = 0;
+		}
+		shader = &next;
+		GLuint vs = Compile(GL_VERTEX_SHADER, vertex_source, next.name);
+		GLuint fs = Compile(GL_FRAGMENT_SHADER, fragment_prefix + next.source + fragment_suffix, next.name);
+		if (vs && fs) {
+			program = gl.CreateProgram();
+			gl.AttachShader(program, vs);
+			gl.AttachShader(program, fs);
+			gl.LinkProgram(program);
+			GLint ok = 0;
+			gl.GetProgramiv(program, GL_LINK_STATUS, &ok);
+			if (!ok) {
+				char log[2048] = {};
+				gl.GetProgramInfoLog(program, sizeof(log), nullptr, log);
+				Output::Warning("ScreenShader: Shader/{}.glsl does not link:\n{}", next.name, log);
+				gl.DeleteProgram(program);
+				program = 0;
+			}
+		}
+		if (vs) gl.DeleteShader(vs);
+		if (fs) gl.DeleteShader(fs);
+		if (!program) {
+			failed = next.name;
+			return false;
+		}
+		Output::Debug("ScreenShader: using Shader/{}.glsl", next.name);
+		return true;
+	}
+};
+
+Sdl2ShaderPass::Sdl2ShaderPass() : impl(std::make_unique<Impl>()) {
+	impl->capture = std::getenv("EASYRPG_SHADER_CAPTURE");
+	if (const char* frame = std::getenv("EASYRPG_SHADER_CAPTURE_FRAME")) {
+		impl->capture_frame = std::atoi(frame);
+	}
+}
+
+Sdl2ShaderPass::~Sdl2ShaderPass() = default;
+
+bool Sdl2ShaderPass::Draw(SDL_Renderer* renderer, SDL_Texture* texture, const SDL_Rect& viewport, int screen_width, int screen_height) {
+	std::vector<ScreenShader::Param> values;
+	const ScreenShader::Shader* shader = ScreenShader::Current(values);
+	if (!shader) {
+		return false;
+	}
+	auto& gl = impl->gl;
+	if (!impl->checked) {
+		impl->checked = true;
+		SDL_RendererInfo info = {};
+		SDL_GetRendererInfo(renderer, &info);
+		if (!info.name || std::strcmp(info.name, "opengl") != 0) {
+			Output::Warning("ScreenShader: shaders need SDL's OpenGL renderer, not \"{}\"; drawing without them", info.name ? info.name : "?");
+			return false;
+		}
+		impl->usable = gl.Load();
+	}
+	if (!impl->usable) {
+		return false;
+	}
+
+	SDL_RenderFlush(renderer); // SDL's queued commands (the clear) first
+	if (!impl->Use(*shader)) {
+		return false;
+	}
+
+	GLint previous_program = 0;
+	gl.GetIntegerv(GL_CURRENT_PROGRAM, &previous_program);
+	gl.PushAttrib(GL_ALL_ATTRIB_BITS);
+	gl.PushClientAttrib(GL_CLIENT_ALL_ATTRIB_BITS);
+	gl.ActiveTexture(GL_TEXTURE0);
+	float tex_w = 1.f, tex_h = 1.f;
+	bool drawn = false;
+	if (SDL_GL_BindTexture(texture, &tex_w, &tex_h) == 0) {
+		GLuint p = impl->program;
+		gl.UseProgram(p);
+		gl.Uniform1i(gl.GetUniformLocation(p, "lcf_screen"), 0);
+		gl.Uniform2f(gl.GetUniformLocation(p, "lcf_tex_scale"), tex_w, tex_h);
+		gl.Uniform2f(gl.GetUniformLocation(p, "resolution"), static_cast<float>(screen_width), static_cast<float>(screen_height));
+		gl.Uniform1f(gl.GetUniformLocation(p, "time"), SDL_GetTicks() / 1000.f);
+		for (const auto& v : values) {
+			GLint at = gl.GetUniformLocation(p, v.name.c_str());
+			switch (v.size) {
+				case 1: gl.Uniform1f(at, v.value[0]); break;
+				case 2: gl.Uniform2f(at, v.value[0], v.value[1]); break;
+				case 3: gl.Uniform3f(at, v.value[0], v.value[1], v.value[2]); break;
+				default: gl.Uniform4f(at, v.value[0], v.value[1], v.value[2], v.value[3]); break;
+			}
+		}
+
+		int out_w = 0, out_h = 0;
+		SDL_GetRendererOutputSize(renderer, &out_w, &out_h);
+		const int gl_y = out_h - viewport.y - viewport.h; // OpenGL counts from the bottom
+		gl.Viewport(viewport.x, gl_y, viewport.w, viewport.h);
+		gl.Disable(GL_BLEND);
+		gl.Disable(GL_SCISSOR_TEST);
+		gl.Disable(GL_DEPTH_TEST);
+		gl.Disable(GL_CULL_FACE);
+		gl.Begin(GL_QUADS);
+		gl.TexCoord2f(0.f, 0.f); gl.Vertex2f(-1.f, 1.f);
+		gl.TexCoord2f(1.f, 0.f); gl.Vertex2f(1.f, 1.f);
+		gl.TexCoord2f(1.f, 1.f); gl.Vertex2f(1.f, -1.f);
+		gl.TexCoord2f(0.f, 1.f); gl.Vertex2f(-1.f, -1.f);
+		gl.End();
+
+		const int frames = Player::GetFrames();
+		const bool capture_now = impl->capture_frame < 0 ? frames % 10 == 0 : (!impl->captured && frames >= impl->capture_frame);
+		if (impl->capture && capture_now && viewport.w > 0 && viewport.h > 0) {
+			impl->captured = true;
+			const int stride = (viewport.w * 3 + 3) & ~3;
+			std::vector<unsigned char> bgr(static_cast<size_t>(stride) * viewport.h);
+			gl.PixelStorei(GL_PACK_ALIGNMENT, 4);
+			gl.ReadPixels(viewport.x, gl_y, viewport.w, viewport.h, GL_BGR, GL_UNSIGNED_BYTE, bgr.data());
+			WriteBmp(impl->capture, viewport.w, viewport.h, bgr, stride);
+		}
+
+		gl.UseProgram(previous_program);
+		SDL_GL_UnbindTexture(texture);
+		drawn = true;
+	}
+	gl.PopClientAttrib();
+	gl.PopAttrib();
+	return drawn;
+}
