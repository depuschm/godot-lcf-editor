+#ifndef EP_SDL2_SHADER_H
+#define EP_SDL2_SHADER_H
+
+#include <SDL.h>
+#include <memory>
+
+/**
+ * Draws the game texture with a screen shader (see screen_shader.h) through the
+ * OpenGL context of SDL's "opengl" renderer: SDL draws everything else, this pass
+ * only replaces the final copy of the game texture to the window.
+ *
+ * For tests: with the environment variable EASYRPG_SHADER_CAPTURE=<file.bmp> the
+ * shaded frame is written to that file every 10 frames, or only once at frame
+ * EASYRPG_SHADER_CAPTURE_FRAME=<n> (Player::GetFrames()) when that is set.
+ */
+class Sdl2ShaderPass {
+public:
+	Sdl2ShaderPass();
+	~Sdl2ShaderPass();
+
+	/**
+	 * Draws `texture` into `viewport` with the current screen shader.
+	 * @return false if there is no shader or it cannot be used; draw normally then.
+	 */
+	bool Draw(SDL_Renderer* renderer, SDL_Texture* texture, const SDL_Rect& viewport, int screen_width, int screen_height);
+
+private:
+	struct Impl;
+	std::unique_ptr<Impl> impl;
+};
+
+#endif
