+ */
+
+#include "screen_shader.h"
+#include "filefinder.h"
+#include "game_map.h"
+#include "main_data.h"
+#include "output.h"
+
+#ifdef HAVE_NLOHMANN_JSON
+#include "json_helper.h"
+#endif
+
+#include <cctype>
+#include <cstdlib>
+#include <iterator>
+#include <map>
+#include <optional>
+#include <sstream>
+
+namespace {
+	// A shader with parameter values, as chosen for a map.
+	struct Choice {
+		std::string shader;
+		std::map<std::string, std::vector<float>> params;
+	};
+
+	struct ShaderState {
+		bool loaded = false;
+		bool used = false;
+		std::optional<Choice> fallback;    // "default"
+		std::map<int, Choice> maps;        // "maps"
+		std::map<std::string, std::optional<ScreenShader::Shader>> shaders; // loaded files (nullopt: missing)
+		// Session (comment commands)
+		std::optional<std::string> session_shader;
+		std::map<std::string, std::map<std::string, std::vector<float>>> session_params;
+	} state;
+
+#ifdef HAVE_NLOHMANN_JSON
+	Choice ReadChoice(const json& j) {
+		Choice c;
+		if (j.is_string()) {
+			c.shader = j.get<std::string>();
+			return c;
+		}
+		if (!j.is_object()) {
+			return c;
+		}
+		c.shader = j.value("shader", "");
+		if (j.contains("params") && j["params"].is_object()) {
+			for (const auto& [name, value] : j["params"].items()) {
+				std::vector<float> v;
+				if (value.is_number()) {
+					v.push_back(value.get<float>());
+				} else if (value.is_array()) {
+					for (const auto& x : value) {
+						if (x.is_number()) {
+							v.push_back(x.get<float>());
+						}
+					}
+				}
+				c.params[name] = v;
+			}
+		}
+		return c;
+	}
+#endif
+
+	void Load() {
+		if (state.loaded) {
+			return;
+		}
+		if (!FileFinder::Game()) {
+			return; // no game yet (game browser): try again later
+		}
+		state.loaded = true;
+		auto is = FileFinder::Game().OpenFile("lcf-plugins", "shaders.json");
+		if (!is) {
+			return;
+		}
+		state.used = true;
+#ifdef HAVE_NLOHMANN_JSON
+		std::string text((std::istreambuf_iterator<char>(is)), std::istreambuf_iterator<char>());
+		json j = json::parse(text, nullptr, false);
+		if (j.is_discarded() || !j.is_object()) {
+			Output::Warning("ScreenShader: lcf-plugins/shaders.json is not valid JSON");
+			return;
+		}
+		if (j.contains("default") && !j["default"].is_null()) {
+			state.fallback = ReadChoice(j["default"]);
+		}
+		if (j.contains("maps") && j["maps"].is_object()) {
+			for (const auto& [id, choice] : j["maps"].items()) {
+				state.maps[std::atoi(id.c_str())] = ReadChoice(choice);
+			}
+		}
+		Output::Debug("ScreenShader: {} map(s) with a shader{}", state.maps.size(),
+			state.fallback ? ", default \"" + state.fallback->shader + "\"" : "");
+#else
+		Output::Warning("ScreenShader: this Player was built without JSON support; shaders.json is ignored");
+#endif
+	}
+
+	const ScreenShader::Shader* Find(const std::string& name) {
+		auto it = state.shaders.find(name);
+		if (it == state.shaders.end()) {
+			std::optional<ScreenShader::Shader> shader;
+			auto is = FileFinder::Game().OpenFile("Shader", name + ".glsl");
+			if (is) {
+				shader = ScreenShader::Shader();
+				shader->name = name;
+				shader->source.assign(std::istreambuf_iterator<char>(is), std::istreambuf_iterator<char>());
+				shader->params = ScreenShader::ParseParams(shader->source);
+				Output::Debug("ScreenShader: loaded Shader/{}.glsl ({} parameter(s))", name, shader->params.size());
+			} else {
+				Output::Warning("ScreenShader: Shader/{}.glsl not found", name);
+			}
+			it = state.shaders.emplace(name, std::move(shader)).first;
+		}
+		return it->second ? &*it->second : nullptr;
+	}
+
+	void Apply(std::vector<ScreenShader::Param>& values, const std::map<std::string, std::vector<float>>& params) {
+		for (auto& p : values) {
+			auto it = params.find(p.name);
+			if (it != params.end()) {
+				for (int i = 0; i < p.size && i < static_cast<int>(it->second.size()); ++i) {
+					p.value[i] = it->second[i];
+				}
+			}
+		}
+	}
+
+	std::string Trim(std::string_view s) {
+		size_t a = 0, b = s.size();
+		while (a < b && std::isspace(static_cast<unsigned char>(s[a]))) ++a;
+		while (b > a && std::isspace(static_cast<unsigned char>(s[b - 1]))) --b;
+		return std::string(s.substr(a, b - a));
+	}
+}
+
+bool ScreenShader::IsUsed() {
+	Load();
+	return state.used;
+}
+
+std::vector<ScreenShader::Param> ScreenShader::ParseParams(std::string_view source) {
+	std::vector<Param> params;
+	std::istringstream lines{std::string(source)};
+	std::string line;
+	while (std::getline(lines, line)) {
+		auto code = Trim(line);
+		if (code.compare(0, 8, "uniform ") != 0) {
+			continue;
+		}
+		std::string comment;
+		auto slashes = code.find("//");
+		if (slashes != std::string::npos) {
+			comment = code.substr(slashes + 2);
+			code = Trim(code.substr(0, slashes));
+		}
+		// "uniform <type> <name>;"
+		std::istringstream words(code);
+		std::string uniform, type, name;
+		words >> uniform >> type >> name;
+		if (!name.empty() && name.back() == ';') {
+			name.pop_back();
+		}
+		Param p;
+		if (type == "float") p.size = 1;
+		else if (type == "vec2") p.size = 2;
+		else if (type == "vec3") p.size = 3;
+		else if (type == "vec4") p.size = 4;
+		else continue;
+		if (name.empty()) {
+			continue;
+		}
+		p.name = name;
+		// Defaults: the numbers in the comment before an optional "[min, max]".
+		auto bracket = comment.find('[');
+		if (bracket != std::string::npos) {
+			comment.resize(bracket);
+		}
+		int n = 0;
+		const char* s = comment.c_str();
+		while (*s && n < p.size) {
+			if (std::isdigit(static_cast<unsigned char>(*s)) || ((*s == '-' || *s == '.') && std::isdigit(static_cast<unsigned char>(s[1])))) {
+				char* end = nullptr;
+				p.value[n++] = std::strtof(s, &end);
+				s = end;
+			} else {
+				++s;
+			}
+		}
+		if (n == 1) {
+			for (int i = 1; i < p.size; ++i) p.value[i] = p.value[0];
+		}
+		if (p.size == 4 && n != 1 && n < 4) {
+			p.value[3] = 1.0f; // a colour without alpha
+		}
+		params.push_back(p);
+	}
+	return params;
+}
+
+const ScreenShader::Shader* ScreenShader::Current(std::vector<Param>& values) {
+	values.clear();
+	Load();
+	if (!state.used) {
+		return nullptr;
+	}
+	const Choice* choice = nullptr;
+	auto map = state.maps.find(Main_Data::game_player ? Game_Map::GetMapId() : 0);
+	if (map != state.maps.end()) {
+		choice = &map->second;
+	} else if (state.fallback) {
+		choice = &*state.fallback;
+	}
+	std::string name = choice ? choice->shader : "";
+	if (state.session_shader) {
+		name = *state.session_shader;
+	}
+	if (name.empty() || name == "none") {
+		return nullptr;
+	}
+	const Shader* shader = Find(name);
+	if (!shader) {
+		return nullptr;
+	}
+	values = shader->params;
+	if (choice && choice->shader == name) {
+		Apply(values, choice->params);
+	}
+	auto session = state.session_params.find(name);
+	if (session != state.session_params.end()) {
+		Apply(values, session->second);
+	}
+	return shader;
+}
+
+void ScreenShader::ResetSession() {
+	state.session_shader.reset();
+	state.session_params.clear();
+}
+
+void ScreenShader::Reset() {
+	state = ShaderState();
+}
+
+bool ScreenShader::Plugin::Invoke(std::string_view func, dyn_arg_list args, bool&, Game_Interpreter*) {
+	if (func == "shader") {
+		bool okay = false;
+		std::string name;
+		std::tie(name) = DynRpg::ParseArgs<std::string>(func, args, &okay);
+		if (okay) {
+			if (name.empty()) {
+				state.session_shader.reset();
+			} else {
+				state.session_shader = name;
+			}
+			Output::Debug("ScreenShader: @shader \"{}\"", name);
+		}
+		return true;
+	}
+	if (func == "shader_param") {
+		bool okay = false;
+		std::string name;
+		float value = 0.f;
+		std::tie(name, value) = DynRpg::ParseArgs<std::string, float>(func, args, &okay);
+		if (!okay) {
+			return true;
+		}
+		if (args.size() > 2) {
+			float div = 1.f;
+			std::tie(std::ignore, std::ignore, div) = DynRpg::ParseArgs<std::string, float, float>(func, args, &okay);
+			if (okay && div != 0.f) {
+				value /= div;
+			}
+		}
+		std::vector<Param> values;
+		const Shader* shader = Current(values);
+		if (!shader) {
+			Output::Debug("ScreenShader: @shader_param {} without a shader", name);
+			return true;
+		}
+		state.session_params[shader->name][name] = { value, value, value, value };
+		return true;
+	}
+	return false;
+}
