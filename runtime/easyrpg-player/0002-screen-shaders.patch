+#ifndef EP_SCREEN_SHADER_H
+#define EP_SCREEN_SHADER_H
+
+#include "game_dynrpg.h"
+#include <array>
+#include <string>
+#include <string_view>
+#include <vector>
+
+/**
+ * Screen shaders (prototype): a GLSL post-process pass over the finished frame,
+ * chosen per map. The pass itself is drawn by the platform UI (SDL2 with the
+ * OpenGL renderer, see platform/sdl/sdl2_shader.h); this part decides which shader
+ * and which parameter values to use.
+ *
+ * Opt-in per game: lcf-plugins/shaders.json in the game folder (written by the
+ * shader plugin of godot-lcf-editor), with shaders in the game's Shader folder:
+ *
+ *     { "default": { "shader": "crt" },
+ *       "maps": { "1": { "shader": "night", "params": { "strength": 0.8 } } } }
+ *
+ * A shader file (Shader/<name>.glsl) defines `vec4 effect(vec2 uv)` and may call
+ * `pixel(uv)` (the game screen, uv 0..1 from the top left) and use `resolution`
+ * (the screen size in pixels) and `time` (seconds). Parameters are uniforms with
+ * their default value in a trailing comment:
+ *
+ *     uniform float strength; // 0.7 [0, 1]
+ *     uniform vec3 tint; // color 0.4, 0.5, 1.0
+ *
+ * Comment commands (with EasyRPG extensions or in DynRPG mode):
+ *   @shader "name"                      use this shader from now on ("none" for no
+ *                                       shader, "" to go back to the map's shader)
+ *   @shader_param "name", value[, div]  set a parameter of the shader in use to
+ *                                       value / div (e.g. V12, 100 for a variable)
+ */
+namespace ScreenShader {
+	/** A shader parameter: a float uniform or a vector of up to four floats. */
+	struct Param {
+		std::string name;
+		int size = 1;
+		std::array<float, 4> value = {};
+	};
+
+	/** A shader file. */
+	struct Shader {
+		std::string name;
+		std::string source;
+		std::vector<Param> params; // with their defaults
+	};
+
+	/** True if the game has lcf-plugins/shaders.json (the UI then needs OpenGL). */
+	bool IsUsed();
+
+	/**
+	 * The shader for the current frame, from the map's setting or @shader.
+	 * @param values receives the parameter values to use
+	 * @return the shader, or nullptr for none. Valid until Reset().
+	 */
+	const Shader* Current(std::vector<Param>& values);
+
+	/** The parameters a shader source declares, with their defaults. */
+	std::vector<Param> ParseParams(std::string_view source);
+
+	/** Forgets @shader and @shader_param (new game, loaded game). */
+	void ResetSession();
+
+	/** Forgets everything, including the settings file and loaded shaders. */
+	void Reset();
+
+	/** The shader comment commands. */
+	class Plugin : public DynRpgPlugin {
+	public:
+		explicit Plugin(Game_DynRpg& instance) : DynRpgPlugin("ScreenShader", instance) {}
+		bool Invoke(std::string_view func, dyn_arg_list args, bool& do_yield, Game_Interpreter* interpreter) override;
+	};
+}
+
+#endif
